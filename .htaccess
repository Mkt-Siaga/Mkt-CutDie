# Mkt-CutDie em hospedagem Apache (GoDaddy cPanel)
Options -Indexes
DirectoryIndex index.html

# Sempre HTTPS (a cifra no navegador exige contexto seguro)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

AddType application/octet-stream .bin
AddType image/svg+xml .svg

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "no-referrer"
  # conteúdo muda a cada build: sempre revalidar
  <FilesMatch "\.(html|js|css|json|bin)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# não servir arquivos de controle
<FilesMatch "^(README\.md|\.git.*)$">
  Require all denied
</FilesMatch>
